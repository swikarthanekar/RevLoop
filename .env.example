# RevLoop — environment placeholders (copy to .env and fill in locally)
# Never commit real secrets.

# Backend
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/revloop
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
MODEL_BUNDLE_PATH=./models/recovery_model_v1.joblib
APP_ENV=development
DEMO_MODE=true
PUBLIC_APP_BASE_URL=http://localhost:3000

# Frontend (non-secret public config only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
