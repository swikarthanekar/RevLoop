# RevLoop — environment placeholders (copy to .env and fill in locally)
# Never commit real secrets. See DEPLOYMENT.md for the hosted configuration.

# =============================================================================
# Backend — application (Railway service variables)
# =============================================================================
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# Exact browser origin allowed by CORS. In a deployment this is the Vercel
# production URL, scheme included, e.g. https://your-project.vercel.app
PUBLIC_APP_BASE_URL=http://localhost:3000

# =============================================================================
# Supabase — database and auth (backend only)
# =============================================================================
# Local development uses a local PostgreSQL. A deployment uses the Supabase
# session pooler connection string on port 5432; postgresql:// and postgres://
# are both normalized to the psycopg driver automatically.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/revloop

# Verifies Supabase-issued access tokens in production (SupabaseAuthBackend).
# Only used for a project on the legacy shared HS256 secret — read it from
# Supabase Project Settings -> API -> JWT Secret. A newer/migrated project
# signs asymmetrically (ES256) instead, verified via SUPABASE_URL below, in
# which case this value is unused; either or both may be needed depending on
# which token(s) the project actually issues.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Same value as the frontend's NEXT_PUBLIC_SUPABASE_URL — not a secret, just
# not otherwise needed by the backend. Required to verify an ES256-signed
# token (fetches the project's public JWKS at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json); unused for an HS256 project.
SUPABASE_URL=https://<project-ref>.supabase.co

# =============================================================================
# Development auth (Bearer dev-analyst / dev-operator / dev-admin)
# =============================================================================
# Only used when APP_ENV is development or test. Point these at the canonical
# demo tenant when running against demo seed data, otherwise the authenticated
# session is scoped to an empty organization.
DEV_AUTH_USER_ID=bc9f0349-0af8-557e-9557-4bdaadda544d
DEV_AUTH_ORGANIZATION_ID=82757dbc-e0d0-5285-8f26-7a9ab9837a24

# =============================================================================
# Razorpay — Test Mode (backend only, never NEXT_PUBLIC)
# =============================================================================
RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Leave unset. It defaults to the canonical host https://api.razorpay.com and
# is rejected outright in production. The override exists so the browser test
# suite can point the real client at a local stub.
# RAZORPAY_API_BASE_URL=

# =============================================================================
# Gemini — optional (backend only, never NEXT_PUBLIC)
# =============================================================================
# With no key the deterministic template fallback is used and the demo works
# unchanged. Nothing in the core flow depends on the LLM.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# =============================================================================
# Model artifact
# =============================================================================
# Inference falls back to the artifact shipped at
# apps/api/app/ml/artifacts/recovery_model.joblib when this path is missing.
# The deployment image sets this to the artifact it ships.
MODEL_BUNDLE_PATH=./models/recovery_model_v1.joblib

# =============================================================================
# Frontend — public browser configuration only (Vercel)
# =============================================================================
# Inlined into the browser bundle at build time. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=demo

# Supabase Auth (browser). Both values are safe to expose — see
# lib/config/public.ts — and are used only for sign-in/session, never for
# direct data access. When BOTH are set, the frontend requires a real
# Supabase sign-in (a /login page) and NEXT_PUBLIC_DEV_AUTH_TOKEN below is
# ignored; when either is unset, the dev-token path is used instead.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional "Continue as demo" button on /login, for judges/reviewers who
# shouldn't need to type credentials. Only takes effect when Supabase is
# configured above. Carries the same disclosed tradeoff as
# NEXT_PUBLIC_DEV_AUTH_TOKEN below: inlined into the public bundle, so only
# ever point this at an account scoped to demo/synthetic data (see
# DEPLOYMENT.md section 2.5) — never a real customer or personal account.
# NEXT_PUBLIC_DEMO_LOGIN_EMAIL=demo@example.com
# NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=your-demo-account-password

# Local/demo bearer token for the development auth backend. Leave unset here and
# NEVER set it on a public deployment unless Supabase auth above is NOT
# configured — it would publish an ADMIN credential in the browser bundle.
# NEXT_PUBLIC_DEV_AUTH_TOKEN=
